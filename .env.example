POSTGRES_DB=politician_dashboard
POSTGRES_USER=dashboard_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://dashboard_app:change-me@127.0.0.1:5432/politician_dashboard
# Local development resource metadata; production Compose sets environment=production.
OTEL_SERVICE_NAME=politician-dashboard-api
OTEL_SERVICE_NAMESPACE=politician-dashboard
OTEL_DEPLOYMENT_ENVIRONMENT=development
# Optional OTLP export settings; supply endpoint and headers through local/deployment secrets.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=
